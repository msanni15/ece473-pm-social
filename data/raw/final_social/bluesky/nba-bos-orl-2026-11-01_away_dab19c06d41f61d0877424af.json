ount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-11-01T22:10:14.279Z", "labels": []}, {"uri": "at://did:plc:ov7yyu2taf5uzitjznhc2rto/app.bsky.feed.post/3mzbt3v3k3223", "cid": "bafyreidubxtjrgiho6g3dg7c7ryfzpexb4wwrped4qyftreybytiwgx3oq", "author": {"did": "did:plc:ov7yyu2taf5uzitjznhc2rto", "handle": "modakhilnba.bsky.social", "displayName": "Mo Dakhil", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ov7yyu2taf5uzitjznhc2rto/bafkreidkjmigyp7unvb2kmttmea3kkue3cdjcrmb5vskrdorru6nhxfqxm", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-05-15T20:58:01.816Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T22:08:08.533Z", "langs": ["en"], "text": "The Magic are giving the ball away it fees like every other possession. Some of it has been the Celtics defense and some of it has been the sloppiest basketball I have seen in a while"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 1, "quoteCount": 0, "indexedAt": "2026-11-01T22:08:08.877Z", "labels": []}, {"uri": "at://did:plc:dnxkqc6rsqossh7uhyobkeua/app.bsky.feed.post/3mzbt23ym5s2p", "cid": "bafyreihp5h2xrwrttg2qty4fnlp2h55h4a6njq664xenlqxfzqps4hyqbe", "author": {"did": "did:plc:dnxkqc6rsqossh7uhyobkeua", "handle": "bobbykrivitsky.bsky.social", "displayName": "Bobby Krivitsky", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:dnxkqc6rsqossh7uhyobkeua/bafkreico5zyufbnodb5nzc2crnx7rm453722niv7tsvca3u2mrjotqiasq", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-13T21:39:03.382Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T22:07:08.667Z", "langs": ["en"], "text": "The Magic have 4 turnovers in the first 3:30 of the second half. They have 13 turnovers in the game. The Celtics have a 15-0 advantage in points off TOs. Boston leads 64-52."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 1, "quoteCount": 0, "indexedAt": "2026-11-01T22:07:09.179Z", "labels": []}, {"uri": "at://did:plc:hqrpav4bwt4zphlck4or73dg/app.bsky.feed.post/3mzbsq4ablk2n", "cid": "bafyreiewgvi7vnjk3si4slpt4qc2x53nydchjo6zz6azsgvmd73vysa6re", "author": {"did": "did:plc:hqrpav4bwt4zphlck4or73dg", "handle": "mikedynon.bsky.social", "displayName": "Mike Dynon \u2618\ufe0f\ud83c\udfc0 18\ud83c\udfc6", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:hqrpav4bwt4zphlck4or73dg/bafkreihrepccmach4x2xscjdhwpueb2gyoxrwrajo7vbfvwhfxcqduxwqi", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-11-14T16:13:04.644Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T22:01:33.373Z", "langs": ["en"], "text": "How many times have we seen the Celtics force consecutive 24-second violations? With a steal on the next possession as a bonus? Maybe when KG was here, but not often. That's some grit."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 10, "quoteCount": 0, "indexedAt": "2026-11-01T22:01:32.875Z", "labels": []}, {"uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3mzbsn53lvk2x", "cid": "bafyreiddxzffn4w4ihhzi3uscp4ubtqcsswxs6q64niai7f5bcxk5trc5q", "author": {"did": "did:plc:fkpnckg4eqizwxmgrxrgwyxo", "handle": "philiprr.bsky.social", "displayName": "Philip Rossman-Reich", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fkpnckg4eqizwxmgrxrgwyxo/bafkreia5yytn63svxtqdkdptgsmyydn6pq4k5kko77upzeyupxjbgkwkke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-18T16:37:49.540Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T21:59:53.603Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 6, "byteStart": 0}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Celtics"}], "index": {"byteEn