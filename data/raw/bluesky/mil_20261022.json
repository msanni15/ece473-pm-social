[{"team": "mil", "query": "\"Milwaukee Bucks\"", "hour": "2026-10-22T00:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:2py26y2vffajxu6uexbfbyg4/app.bsky.feed.post/3myggpl2atc2r", "author_did": "did:plc:2py26y2vffajxu6uexbfbyg4", "handle": "mitchellnba.bsky.social", "created_at": "2026-10-22T00:44:37.514Z", "indexed_at": "2026-10-22T00:44:38.046Z", "text": "The 2026-27 Milwaukee Bucks are *feisty*"}, {"uri": "at://did:plc:ywsla6rhibn7h3w6oi6sgkrc/app.bsky.feed.post/3mygf7g46zn2m", "author_did": "did:plc:ywsla6rhibn7h3w6oi6sgkrc", "handle": "nbarealtimestats.bsky.social", "created_at": "2026-10-22T00:17:41.308283+00:00", "indexed_at": "2026-10-22T00:17:41.847Z", "text": "Halftime \u2014 Milwaukee Bucks lead by 5\n\nMIL 56\nWSH 51\n\nAnthony Davis: 12 pts, 7 reb, 2 ast\nTyler Herro: 14 pts, 1 reb, 4 ast\n\n#NBA #Wizards #Bucks"}]}, {"team": "mil", "query": "\"Milwaukee Bucks\"", "hour": "2026-10-22T01:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:npwuvhuq3bv4m4mjlkq77cjw/app.bsky.feed.post/3mygkg5lnaz2q", "author_did": "did:plc:npwuvhuq3bv4m4mjlkq77cjw", "handle": "wirereport.bsky.social", "created_at": "2026-10-22T01:50:55.059166Z", "indexed_at": "2026-10-22T01:50:57.235Z", "text": "FINAL: Milwaukee Bucks 116, Washington Wizards 128\n\n\ud83c\udfc0 Anthony Davis: 34 PTS, 12 REB, 4 AST, 2 STL, 1 BLK\n\ud83c\udfc0 Trae Young: 20 PTS, 13 AST, 2 STL\n\nWashington Wizards trailed by 5 after the 2nd quarter before outscoring Milwaukee Bucks 38-23 in the 4th quarter."}, {"uri": "at://did:plc:ez2i445ie5lrv2m7myr2himx/app.bsky.feed.post/3mygkfo3rx22p", "author_did": "did:plc:ez2i445ie5lrv2m7myr2himx", "handle": "nedzeppelin.bsky.social", "created_at": "2026-10-22T01:50:40.133Z", "indexed_at": "2026-10-22T01:50:40.453Z", "text": "Eat shit, Miami Heat. You ruined the Milwaukee Bucks for me. I hope you guys lose every game this season."}, {"uri": "at://did:plc:2ta7vtswcmr6cjgnr7zyltz2/app.bsky.feed.post/3mygkd4y3ri2m", "author_did": "did:plc:2ta7vtswcmr6cjgnr7zyltz2", "handle": "sofialertbot.bsky.social", "created_at": "2026-10-22T01:49:14+00:00", "indexed_at": "2026-10-22T01:49:15.743Z", "text": "\ud83e\udd16 #SofiAlert \n\ud83d\udcc5 21-10-2026 \nMilwaukee Bucks - Washington Wizards \n\ud83d\udecb 4.2/5 Sofis"}, {"uri": "at://did:plc:gcd5s7km6tnspiajzwmt44tb/app.bsky.feed.post/3mygk5zssfc2h", "author_did": "did:plc:gcd5s7km6tnspiajzwmt44tb", "handle": "dcabloob.com", "created_at": "2026-10-22T01:46:23.984Z", "indexed_at": "2026-10-22T01:46:25.742Z", "text": "NBA basketball - Washington Wizards 128 Milwaukee Bucks 116 (final) - #Wizards #NBA"}, {"uri": "at://did:plc:bw5jvrpkauznkzx6kx3jmmql/app.bsky.feed.post/3mygjy74qhs2a", "author_did": "did:plc:bw5jvrpkauznkzx6kx3jmmql", "handle": "milwaukeezack.bsky.social", "created_at": "2026-10-22T01:43:08.224Z", "indexed_at": "2026-10-22T01:43:09.249Z", "text": "The feed on the low rent tv channel for Bucks games OTA keeps cutting out.  It really is the Channel 18 era all over again.  Let\u2019s have some fun this year Bucks fans!"}, {"uri": "at://did:plc:crcybmshorvvegmbkp5rvgjv/app.bsky.feed.post/3mygisq7g222z", "author_did": "did:plc:crcybmshorvvegmbkp5rvgjv", "handle": "nbcswarriors.bsky.social", "created_at": "2026-10-22T01:22:11.073Z", "indexed_at": "2026-10-22T01:22:12.643Z", "text": "The Warriors reportedly reached out to the Bucks about a Kristaps Porzi\u0146\u0123is trade as he continues to battle health issues \ud83e\udd14"}, {"uri": "at://did:plc:qrhfqquwwfxtcmfdagze6shg/app.bsky.feed.post/3mygi6edt7c2k", "author_did": "did:plc:qrhfqquwwfxtcmfdagze6shg", "handle": "mycupcakesaremoist.bsky.social", "created_at": "2026-10-22T01:10:47.541Z", "indexed_at": "2026-10-22T01:10:48.136Z", "text": "*whispers* This year\u2019s Miami Heat roster is no better than last year\u2019s Milwaukee Bucks roster."}]}, {"team": "mil", "query": "\"Milwaukee Bucks\"", "hour": "2026-10-22T02:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:nuh7mgbkrq47hoy44xbxbygk/app.bsky.feed.post/3mygnggpcns2u", "author_did": "did:plc:nuh7mgbkrq47hoy44xbxbygk", "handle": "rrovito.bsky.social", "created_at": "2026-10-22T02:44:47.152Z", "indexed_at": "2026-10-22T02:44:48.444Z", "text": "Davis scores 34 points in his Washington debut, leading the #Wizards over #Bucks 128-116"}, {"uri": "at://did:plc:utncxp64doodk3pmctcmhp7n/app.bsky.feed.post/3mygndfyao22o", "author_did": "did:plc:utncxp64doodk3pmctcmhp7n", "handle": "nbcwashington.com", "created_at": "2026-10-22T02:43:05.744Z", "indexed_at": "2026-10-22T02:43:08.537Z", "text": "The Washington Wizards beat the Milwaukee Bucks 128-116. Here are the highlights."}, {"uri": "at://did:plc:vs44vltwcezny5koauxyiqye/app.bsky.feed.post/3mygna7ms7k2o", "author_did": "did:plc:vs44vltwcezny5koauxyiqye", "handle": "timnwachukwu.bsky.social", "created_at": "2026-10-22T02:41:18.351Z", "indexed_at": "2026-10-22T02:41:26.746Z", "text": "Gallery/usage: www.nwachukwu.works/-/collection...\n\nThe Washington Wizards start the season with a 128-116 win (and a Waka Flocka Flame halftime show) over the Milwaukee Bucks, led by a 34-point and 12-rebound debut from Anthony Davis.\n\n#NBA #Basketball #Washington #Wizards #Milwaukee #Bucks"}, {"uri": "at://did:plc:thmlhqcvi7fw7mkxikclysrp/app.bsky.feed.post/3mygmp4yxws2n", "author_did": "did:plc:thmlhqcvi7fw7mkxikclysrp", "handle": "keelstats.bsky.social", "created_at": "2026-10-22T02:31:45.132Z", "indexed_at": "2026-10-22T02:31:46.035Z", "text": "\ud83c\udfc1 Davis scores 34 as Wizards pull away from Bucks 128-116\n\nWashington broke the game open with a fourth-quarter run and took 41 free throws to Milwaukee's 23, while Trae Young handed out 13 assists.\n\n\u2022 Davis: 34 points, 11 of 20 shooting, 12 rebounds\n+2 more\n\nkeelstats.com/news/359\n\n#NBA"}, {"uri": "at://did:plc:lvcs7ffkwlksfks5xd7sbene/app.bsky.feed.post/3myglhoo5br2h", "author_did": "did:plc:lvcs7ffkwlksfks5xd7sbene", "handle": "channel3000.com", "created_at": "2026-10-22T02:09:41.532Z", "indexed_at": "2026-10-22T02:09:42.446Z", "text": "Anthony Davis had 34 points and 12 rebounds in his debut with Washington, and the new-look Wizards beat the Milwaukee Bucks 128-116 on Wednesday night in the season opener for both teams."}, {"uri": "at://did:plc:4pida3lsalxvqmd52sxc5cnf/app.bsky.feed.post/3mygl3qtdcz2p", "author_did": "did:plc:4pida3lsalxvqmd52sxc5cnf", "handle": "onmilwaukee.bsky.social", "created_at": "2026-10-22T02:03:01.18222469Z", "indexed_at": "2026-10-22T02:03:03.037Z", "text": "Fans are invited to celebrate a historic day in Wisconsin sports at Deer District with the Milwaukee Bucks home opener and the World Series to follow: \n\nhttps://onmilwaukee.com/articles/deer-district-watch-parties"}]}, {"team": "mil", "query": "\"Milwaukee Bucks\"", "hour": "2026-10-22T03:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:rw3xa3lwrxoqx2g2rcwpxa34/app.bsky.feed.post/3mygpy27t232t", "author_did": "did:plc:rw3xa3lwrxoqx2g2rcwpxa34", "handle": "620wtmj.bsky.social", "created_at": "2026-10-22T03:30:25Z", "indexed_at": "2026-10-22T03:30:25.735Z", "text": "bit.ly/4k9RbTR"}, {"uri": "at://did:plc:ksagfwkdpserboh3f2zddyo2/app.bsky.feed.post/3mygpxie44m2y", "author_did": "did:plc:ksagfwkdpserboh3f2zddyo2", "handle": "wkow27news.bsky.social", "created_at": "2026-10-22T03:30:06.740Z", "indexed_at": "2026-10-22T03:30:06.949Z", "text": "Anthony Davis had 34 points and 12 rebounds in his debut with Washington, and the new-look Wizards beat the Milwaukee Bucks 128-116 on Wednesday night in the season opener for both teams."}, {"uri": "at://did:plc:wcx6hflrpuasjl5tik7xqiwz/app.bsky.feed.post/3mygomvmbwc2t", "author_did": "did:plc:wcx6hflrpuasjl5tik7xqiwz", "handle": "stevemegargee.bsky.social", "created_at": "2026-10-22T03:06:17.862Z", "indexed_at": "2026-10-22T03:06:19.237Z", "text": "Davis scores 34 points in his Washington debut, leading the #Wizards over #Bucks 128-116 shorturl.at/AppHj"}]}, {"team": "mil", "query": "\"Milwaukee Bucks\"", "hour": "2026-10-22T04:00:00