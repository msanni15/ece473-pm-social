nHvQUYGsVHrIoK"}}, "langs": ["en"], "text": "Celtics and Patriots on at the same damn time"}, "embed": {"external": {"uri": "https://static.klipy.com/ii/39f2394ae36df6e199be9eb7c9fa1012/0d/4b/CrzDogwn.gif?hh=220&ww=220&mp4=Mh5XSymDg8FafgOcJn&webm=LnHvQUYGsVHrIoK", "title": "Chubby Kid Eating Confused", "description": "ALT: Chubby Kid Eating Confused", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:r53fqm2ps52mf2nqubqxed25/bafkreigqm7vgylrw2cr7gsxe7eddf2b2glpslh44yikayjs26huwi5g5zi"}, "$type": "app.bsky.embed.external#view"}, "bookmarkCount": 0, "replyCount": 2, "repostCount": 1, "likeCount": 3, "quoteCount": 0, "indexedAt": "2026-11-01T21:43:43.574Z", "labels": [], "threadgate": {"uri": "at://did:plc:r53fqm2ps52mf2nqubqxed25/app.bsky.feed.threadgate/3mzbrq7k35s2l", "cid": "bafyreibcvetgtyobhz3fckhycqb64elkoyybyjrmtz2ru2g5b4pax3vrju", "record": {"$type": "app.bsky.feed.threadgate", "allow": [{"$type": "app.bsky.feed.threadgate#followerRule"}], "createdAt": "2026-11-01T21:43:43.251Z", "hiddenReplies": [], "post": "at://did:plc:r53fqm2ps52mf2nqubqxed25/app.bsky.feed.post/3mzbrq7k35s2l"}, "lists": []}}, {"uri": "at://did:plc:e7fdktkwv37ws6rljgnoljfz/app.bsky.feed.post/3mzbrpicces2j", "cid": "bafyreid4gvjkxbkqztvwze5ar6nzd23lbaoayk3pljmlorslervqwpgzge", "author": {"did": "did:plc:e7fdktkwv37ws6rljgnoljfz", "handle": "jbeede.bsky.social", "displayName": "Jason Beede", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:e7fdktkwv37ws6rljgnoljfz/bafkreiey3powizzh2yl5k4eyoftbxztccx6pgnmdozyhyyjqybjhhnc2ne", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-20T04:46:42.270Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T21:43:18.728Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 28, "byteStart": 22}}], "langs": ["en"], "text": "Halftime: Celtics 55, #Magic 50\n\nDesmond Bane has 11 points, Anthony Black and Tristan da Silva 9 apiece and Franz Wagner with 8 and 8 assists.\n\nAfter 8 turnovers in the 1st quarter, Orlando only committed 1 in the 2nd frame. Still Boston has gotten up 10 more field goals so far."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 1, "quoteCount": 0, "indexedAt": "2026-11-01T21:43:19.171Z", "labels": []}, {"uri": "at://did:plc:p2jelukgpae2xto536p5tten/app.bsky.feed.post/3mzbrnhs6mk2y", "cid": "bafyreicf3jsdtctjoodlizqn4bksnckuamdvuah5s6liz767uwc37dc7te", "author": {"did": "did:plc:p2jelukgpae2xto536p5tten", "handle": "zgamer200.bsky.social", "displayName": "zgamer200", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:p2jelukgpae2xto536p5tten/bafkreihg37gaods3fd4xssv26vrek242apoorrprgp2d62gnrsqwkp6zj4", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-12-04T03:12:31.725Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T21:42:11.091Z", "langs": ["en"], "text": "The only things keeping ORL in this are the refs and the Celtics not being able to buy a bucket from 3. Otherwise I thought the C's looked like the much better team in the 1st half."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-11-01T21:42:10.281Z", "labels": []}, {"uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3mzbrlpbers2b", "cid": "bafyreigqo2rpdjldf5rjpqtsgtlymah2kozgbz5p6iglo3j4gijfdn4rfe", "author": {"did": "did:plc:fkpnckg4eqizwxmgrxrgwyxo", "handle": "philiprr.bsky.social", "displayName": "Philip Rossman-Reich", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fkpnckg4eqizwxmgrxrgwyxo/bafkreia5yytn63svxtqdkdptgsmyydn6pq4k5kko77upzeyupxjbgkwkke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-18T16:37:49.540Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T21:41:11.818Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 10, "byteStart": 4}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Celtics"}], "index": {"byteEnd": 218, "byteStart": 210}}], "langs": ["en"], "reply": {"parent": {"cid": "bafyreiaftswhnuc33aa46x6cb6et73jffzt4kffsmbg5vjedt2mfnxvl2a", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3mzbrfnn3js2b"}, "root": {"cid": "bafyreiep35ckbnmmztqjmiyu3xd327ow6ssmnny557eerdmd6xhqmyip2q", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3mzbngitdi22p"}}, "text": "The #Magic with a nice push after winning a challenge to close the gap to end the second quarter. But they are over-helping a lot on drives and pick-and-rolls. Lane is wide open for rollers to start kickouts.\n\n#Celtics lead 55-50 at the half."}, "bookmarkCount": 0, "replyCount": 2, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-11-01T21:41:12.374Z", "labels": []}, {"uri": "at://did:plc:ywsla6rhibn7h3w6oi6sgkrc/app.bsky.feed.post/3mzbrl2t2252x", "cid": "bafyreidkwkcphuk7cpnki3r7lmwcj5a62sm7ibqmxqgn7bgot52zfpq5ze", "author": {"did": "did:plc:ywsla6rhibn7h3w6oi6sgkrc", "handle": "nbarealtimestats.bsky.social", "displayName": "NBA Realtime Stats", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ywsla6rhibn7h3w6oi6sgkrc/bafkreicch7wq2uorzqbeoaom3wn6pb627u4sftummbu7itbeo7sk63u3ne", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-15T11:53:40.921Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-01T21:40:49.379208+00:00", "langs": ["en"], "reply": {"$type": "app.bsky.feed.post#replyRef", "parent": {"$type": "com.atproto.repo.strongRef", "cid": "bafyreifj3llk7stn534tarsa5fn5xrs4zl6rei4eeqxb5u5wxuuu4eum5u", "uri": "at://did:plc:ywsla6rhibn7h3w6oi6sgkrc/app.bsky.feed.post/3mzbprb7svh2u"}, "root": {"$type": "com.atproto.repo.strongRef", "cid": "bafyreifj3llk7stn534tarsa5fn5xrs4zl6rei4eeqxb5u5