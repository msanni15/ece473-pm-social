ky.app/img/avatar/plain/did:plc:75ywphuamkbx76cq6efue5y5/bafkreih7kszzs5gl72sg5igovpbjfglyrxgpzrq4dfzi27zy5dgx5ep3im", "associated": {"chat": {"allowIncoming": "none"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-30T19:46:50.450Z", "verification": {"verifications": [{"issuer": "did:plc:z72i7hdynmk6r22z27h6tvur", "issuerDisplayName": "Bluesky", "issuerHandle": "bsky.app", "uri": "at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3m4y5jsuu272r", "isValid": true, "createdAt": "2025-11-06T18:02:50.132Z"}], "verifiedStatus": "valid", "trustedVerifierStatus": "none"}}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:22:58.923Z", "langs": ["en"], "text": "Jamal Shead has already scored as many points tonight as he did in the first three games combined (11). He also has 6 assists in his 18 minutes. Gave the Raptors a much-needed dose of energy when he came off the bench in the 1st Q and has been great since."}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 2, "likeCount": 16, "quoteCount": 0, "indexedAt": "2026-10-29T01:22:59.474Z", "labels": []}, {"uri": "at://did:plc:oyituhz7aqiz3ut7w5vpq36l/app.bsky.feed.post/3myy44ilm2k2x", "cid": "bafyreigw2knvll7ofplprx35jit4j6v7jy7t37rjwfzjxcucfpgv3znrhy", "author": {"did": "did:plc:oyituhz7aqiz3ut7w5vpq36l", "handle": "shivym.bsky.social", "displayName": "ShivyM", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:oyituhz7aqiz3ut7w5vpq36l/bafkreidvt6laev7ojglepiau7kjvcppgmzp2vo3mjkyjzj6dekknm235fa", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [{"src": "did:plc:oyituhz7aqiz3ut7w5vpq36l", "uri": "at://did:plc:oyituhz7aqiz3ut7w5vpq36l/app.bsky.actor.profile/self", "cid": "bafyreibsihowo2ub6xrkyvpp6yzpkcugksklomlpau3lcxfbdax5mhfove", "val": "!no-unauthenticated", "cts": "2024-11-08T02:29:19.898Z"}], "createdAt": "2024-11-08T02:29:21.879Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:22:55.274Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "raptors"}], "index": {"byteEnd": 67, "byteStart": 59}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "wethenorth"}], "index": {"byteEnd": 79, "byteStart": 68}}], "langs": ["en"], "text": "Scottie Barnes was saving his scoring points for tonight! \n#raptors #wethenorth"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 1, "quoteCount": 0, "indexedAt": "2026-10-29T01:22:57.173Z", "labels": []}, {"uri": "at://did:plc:o22kcn5vnrguqz5njofudtnw/app.bsky.feed.post/3myy44iwtgk2v", "cid": "bafyreidwaeolfj6b3zyqtve6k3ku745udkwkgqwfgutyxpadzt4ox26vee", "author": {"did": "did:plc:o22kcn5vnrguqz5njofudtnw", "handle": "liskeard1.bsky.social", "displayName": "Meesh@liskeard1.bsky.social", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:o22kcn5vnrguqz5njofudtnw/bafkreigoxpm4pfn3v3cueyvhtcn5schbmuj3v26cissg73b4meaktdlvdy", "associated": {"chat": {"allowIncoming": "all"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-12T17:34:26.407Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:22:55.643Z", "langs": ["en"], "reply": {"parent": {"cid": "bafyreidwpja4pnmupuqsttjmx5oos7jciyodpfcnudp7oavxyrx6ttraem", "uri": "at://did:plc:4kmc76b6vqs2vy4i5nqjvppr/app.bsky.feed.post/3myy3x7pdjs2l"}, "root": {"cid": "bafyreihkvhnjxww3yf2hfimllelrdamurtr7kymtxmtt54zjef4iwtvgs4", "uri": "at://did:plc:o22kcn5vnrguqz5njofudtnw/app.bsky.feed.post/3myx77egktc2v"}}, "text": "I haven't been watching Brewers much. Been following the Raptors a bit tonight."}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 2, "quoteCount": 0, "indexedAt": "2026-10-29T01:22:56.170Z", "labels": []}, {"uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myy43plfmc2a", "cid": "bafyreihjvv2wdse63lsx3fwwrtqp7eex5u3e7e52qe35vwn2rsz53kxso4", "author": {"did": "did:plc:fkpnckg4eqizwxmgrxrgwyxo", "handle": "philiprr.bsky.social", "displayName": "Philip Rossman-Reich", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fkpnckg4eqizwxmgrxrgwyxo/bafkreia5yytn63svxtqdkdptgsmyydn6pq4k5kko77upzeyupxjbgkwkke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-18T16:37:49.540Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:22:29.054Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Raptors"}], "index": {"byteEnd": 165, "byteStart": 157}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 225, "byteStart": 219}}], "langs": ["en"], "reply": {"parent": {"cid": "bafyreie52h7ccxspfbob7zu3ftnph6xy3b4m5rw6phpasnebcygm4awxym", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myy3nr56gk2a"}, "root": {"cid": "bafyreigjyqwct2o2cay4qdfwgcttbip6thbc7wooqzns3rq4typazgbqma", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxvqv44lk2a"}}, "text": "Jase Richardson has bounced back from the rough first half. He has done a good job finding holes to get his floaters. But he is too small to switch. And the #Raptors are just hunting him if he gets caught in the paint. #Magic don't have many answers.\n\nORL 69:95 TOR 3:02 3rd"}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T01:22:29.575Z", "labels": []}, {"uri": "at://did:plc:3ph7mooqt5acnzv53x5copif/app.bsky.feed.post/3myy3xqkdlc2w", "cid": "bafyreiegi4rh5n2ctztoqqm32mdcibnrd75toiemmh6wpbisqpuboac6mu", "author": {"did": "did:plc:3ph7mooqt5acnzv53x5copif", "handle": "palaeohammer.bsky.social", "displayName": "The Palaeontologist's Hammer", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:3ph7mooqt5acnzv53x5copif/bafkreiea26pdntsqrmcda6rmydsj5whp3c67gdj2zqfr5buf5swrfxqvam", "associated": {"chat": {"allowIncoming": "all"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-13T05:59:19.282Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:20:15.850Z", "embed": {"$type": "app.bsky.embed.record", "record": {"cid": "bafyreig75hrnb4il2yn5uvg6bfy6r2o7zyh65zxed76224gr3vphgbq72y", "uri": "at://did:plc:3ph7mooqt5acnzv53x5copif/app.bsky.feed.post/3myxzoegzl22w"}}, "langs": ["en"], "text": "Jakob picked up 2 more fouls in those 5 minutes but I focused on him closely in that stretch and it was all good play beyond that. Only 1 rebound, but good position every time, allowing other Raptors to get the board. Screens and positioning were immaculate, and he converted when Scottie got to him"}, "embed": {"record": {"uri": "at://did:plc:3ph7mooqt5acnzv53x5copif/app.bsky.feed.post/3myxzoegzl22w", "cid": "bafyreig75hrnb4il2yn5uvg6bfy6r2o7zyh65zxed76224gr3vphgbq72y", "author": {"did": "did:plc:3ph7mooqt5acnzv53x5copif", "handle": "palaeohammer.bsky.social", "displayName": "The Palaeontologist's Hammer", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:3ph7mooqt5acnzv53x5copif/bafkreiea26pdntsqrmcda6rmydsj5whp3c67gdj2zqfr5buf5swrfxqvam", "associated": {"chat": {"allowIncoming": "all"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-13T05:59:19.282Z"}, "value": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T00:39:13.684Z", "langs": ["en"], "text": "A lot of piling on Jakob tonight. \n\nThe visual difference in team play when CMB replaces him is wild.\n\nTrying to be optimistic, Jakob plays a slow game and his screening is excellent. He seems to be moving well and should be able to knock the rust off and contribute better."}, "labels": [], "likeCount": 0, "replyCount": 1, "repostCount": 0, "quoteCount": 1, "opThreadPostIndex": 1, "opThreadPostCount": 2, "indexedAt": "2026-10-29T00:39:14.276Z", "embeds": [], "$type": "app.bsky.embed.record#viewRecord"}, "$type": "app.bsky.embed.record#view"}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T01:20:16.378Z", "labels": []}, {"uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myy3nr56gk2a", "cid": "bafyreie52h7ccxspfbob7zu3ftnph6xy3b4m5rw6phpasnebcygm4awxym", "author": {"did": "did:plc:fkpnckg4eqizwxmgrxrgwyxo", "handle": "philiprr.bsky.social", "displayName": "Philip Rossman-Reich", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fkpnckg4eqizwxmgrxrgwyxo/bafkreia5yytn63svxtqdkdptgsmyydn6pq4k5kko77upzeyupxjbgkwkke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-18T16:37:49.540Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:14:40.923Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 10, "byteStart": 4}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Raptors"}], "index": {"byteEnd": 27, "byteStart": 19}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 215, "byteStart": 209}}], "langs": ["en"], "reply": {"parent": {"cid": "bafyreib7aubt4pgzst3etj7i4hs2nukl3ti6vmmf7yujdgwts6r5fwuih4", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myy37a4xgs2a"}, "root": {"cid": "bafyreigjyqwct2o2cay4qdfwgcttbip6thbc7wooqzns3rq4typazgbqma", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxvqv44lk2a"}}, "text": "The #Magic let the #Raptors find their rhythm in the first half with all of those turnovers. Now they are shooting confidently. They were really struggling offensively to start the year, especially from deep. #Magic aren't dealing with the pressure well.\n\nORL 61:84 TOR 6:19 3rd"}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T01:14:41.476Z", "labels": []}, {"uri": "at://did:plc:i7pcqindxdleiildptnaikoa/app.bsky.feed.post/3myy3ncgmss2g", "cid": "bafyreicucljikqdryczmgkl4bwee4wvzsunmfcgop5z3yfoo7rhfcrsjie", "author": {"did": "did:plc:i7pcqindxdleiildptnaikoa", "handle": "woodleysean.bsky.social", "displayName": "Sean Woodley", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:i7pcqindxdleiildptnaikoa/bafkreif7zlhbnnm3xbaxmsq7ucnjqoicu3sxmsxxm7ahq5st57meipceyy", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-06T18:59:02.580Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:14:25.503Z", "langs": ["en"], "text": "the problem for the raptors is they're very much in a no fuckin' around window so they can't really afford to let this Jak thing stay a problem all year. but they also need a team that has a large capacity for fuckin' around that also has a useful big to send their way, which is a short list."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 9, "quoteCount": 0, "indexedAt": "2026-10-29T01:14:26.174Z", "labels": []}, {"uri": "at://did:plc:ywsla6rhibn7h3w6oi6sgkrc/app.bsky.feed.post/3myy3h36zhb2u", "cid": "bafyreib7tdcojsgyjkboiphtfuqfj34ihv4lqaxydeesn5jqlagflpeqiq", "author": {"did": "did:plc:ywsla6rhibn7h3w6oi6sgkrc", "handle": "nbarealtimestats.bsky.social", "displayName": "NBA Realtime Stats", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ywsla6rhibn7h3w6oi6sgkrc/bafkreicch7wq2uorzqbeoaom3wn6pb627u4sftummbu7itbeo7sk63u3ne", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-15T11:53:40.921Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:10:56.496975+00:00", "langs": ["en"], "reply": {"$type": "app.bsky.feed.post#replyRef", "parent": {"$type": "com.atproto.repo.strongRef", "cid": "bafyreifexm2afvrl7a6654ztbuct2c2dzj3zccqg4fpefzlwce6vqbldly", "uri": "at://did:plc:ywsla6rhibn7h3w6oi6sgkrc/app.bsky.feed.post/3myy25vw4q22i"}, "root": {"$type": "com.atproto.repo.strongRef", "ci