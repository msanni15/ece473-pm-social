[{"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T00:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:kf6pjnmxz7heacbwfkc2jquh/app.bsky.feed.post/3mxurti5yt72d", "author_did": "did:plc:kf6pjnmxz7heacbwfkc2jquh", "handle": "warriorsbot.bsky.social", "created_at": "2026-10-15T00:15:44.281Z", "indexed_at": "2026-10-15T00:15:44.866Z", "text": "BIG 3-Point night for Memphis! The Grizzlies dropped 90 on the Dubs, but what's concerning is the Warriors' 3-PT struggles - just 3 makes in 96 attempts. Can they get their 3-ball going to turn their season around? #Warriors #NBA"}, {"uri": "at://did:plc:n6shz7ftrqpvyycr5hzs4eqn/app.bsky.feed.post/3mxurnm6xaf2t", "author_did": "did:plc:n6shz7ftrqpvyycr5hzs4eqn", "handle": "ccreadsbooks.com", "created_at": "2026-10-15T00:12:27Z", "indexed_at": "2026-10-15T00:12:28.266Z", "text": "BLURB REVEAL!\nEnemy Territory by @isabel__lucero"}, {"uri": "at://did:plc:dlgnuf6usz2u3ik2eqdi2xpk/app.bsky.feed.post/3mxurn4y4x22y", "author_did": "did:plc:dlgnuf6usz2u3ik2eqdi2xpk", "handle": "strouperstar.bsky.social", "created_at": "2026-10-15T00:12:11.523Z", "indexed_at": "2026-10-15T00:12:12.254Z", "text": "Vancouver Grizzlies Othella Harrington who I used to imitate with 6 pump fakes before shooting in the post?"}]}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T01:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:njpr4fc5ibrcm3jac7igqmvg/app.bsky.feed.post/3mxuvgfptu22d", "author_did": "did:plc:njpr4fc5ibrcm3jac7igqmvg", "handle": "shawnjohn.bsky.social", "created_at": "2026-10-15T01:20:00.777Z", "indexed_at": "2026-10-15T01:20:01.164Z", "text": "Tee Morant made it clear there are no hard feelings toward Memphis, saying he never had a real bad day in the city. But when it comes to playing the Grizzlies, Tee said, \u201cWhen we get on that goddamn court, you better know it\u2019s a reckoning.\u201d"}]}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T02:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:ju5ut5kwg637eivkzjnmigbi/app.bsky.feed.post/3mxuyxcffrs2h", "author_did": "did:plc:ju5ut5kwg637eivkzjnmigbi", "handle": "queenrayna1337.bsky.social", "created_at": "2026-10-15T02:23:08.939Z", "indexed_at": "2026-10-15T02:23:09.361Z", "text": "Oh wow, the worst we got was coyotes but they didn't ever go near our house. Have you seen grizzlies or cougars?"}, {"uri": "at://did:plc:ereq6ilv5cz6tpggje74bck4/app.bsky.feed.post/3mxuyo2l5uc2j", "author_did": "did:plc:ereq6ilv5cz6tpggje74bck4", "handle": "miragenos.bsky.social", "created_at": "2026-10-15T02:17:58.750Z", "indexed_at": "2026-10-15T02:17:59.360Z", "text": "I used to live in a trailer home where grizzlies and cougars used to roam, that's nothing to me\n\nThe boredom is what would get me if I'm being honest"}, {"uri": "at://did:plc:oiqhndqetva7x6pipe3qlbfp/app.bsky.feed.post/3mxuxptdqit2i", "author_did": "did:plc:oiqhndqetva7x6pipe3qlbfp", "handle": "dailymemphian.bsky.social", "created_at": "2026-10-15T02:01:04.511Z", "indexed_at": "2026-10-15T02:01:05.159Z", "text": "The question is whether that ship is finally headed somewhere."}]}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T03:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:kf6pjnmxz7heacbwfkc2jquh/app.bsky.feed.post/3mxv46cwfn52o", "author_did": "did:plc:kf6pjnmxz7heacbwfkc2jquh", "handle": "warriorsbot.bsky.social", "created_at": "2026-10-15T03:20:45.266Z", "indexed_at": "2026-10-15T03:20:45.760Z", "text": "UNBELIEVABLE efficiency! The @warriors drop 100 on the Grizzlies with 39/87 FG & 10 3s! That's 44.5% FG & 11.8% 3PT. With this level of shooting, they're UNSTOPPABLE! Can anyone stop the @warriors' 71-9 record streak? #DubNation #NBA"}]}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T04:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T05:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T06:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T07:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T08:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T09:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T10:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T11:00:00+00:00", "status": "ok", "posts": []}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T12:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:4j57tftvmydigwkoigb23atj/app.bsky.feed.post/3mxvzgadyxs2n", "author_did": "did:plc:4j57tftvmydigwkoigb23atj", "handle": "cabinradio.ca", "created_at": "2026-10-15T12:04:09Z", "indexed_at": "2026-10-15T12:04:10.661Z", "text": "An NWT town began keeping grizzlies out of its dump. The bears wandered the streets instead and 32 of them were killed. Leaders hope they're through the worst...."}, {"uri": "at://did:plc:oiqhndqetva7x6pipe3qlbfp/app.bsky.feed.post/3mxvz7huhao22", "author_did": "did:plc:oiqhndqetva7x6pipe3qlbfp", "handle": "dailymemphian.bsky.social", "created_at": "2026-10-15T12:00:22.813Z", "indexed_at": "2026-10-15T12:00:23.869Z", "text": "We\u2019re less than a week away from NBA opening night, and while we\u2019re not quite done with the Memphis Grizzlies\u2019 preseason, let\u2019s take a break to gaze across the landscape in which the home team competes. "}]}, {"team": "mem", "query": "Grizzlies", "hour": "2026-10-15T13:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:ibqvrimob5azhjzbj3b6rxos/app.bsky.feed.post/3mxw5ew2wzc27", "author_did": "did:plc:ibqvrimob5azhjzbj3b6rxos", "handle": "trilln451.bsky.social", "created_at": "2026-10-15T13:15:00.479Z", "indexed_at": "2026-10-15T13:15:01.656Z", "text": "Plus, grizzlies are actually scary"}, {"uri": "at://did:plc:k