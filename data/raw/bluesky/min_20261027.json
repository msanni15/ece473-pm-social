[{"team": "min", "query": "Timberwolves", "hour": "2026-10-27T00:00:00+00:00", "status": "ok", "posts": [{"uri": "at://did:plc:2iffb6bkoemfluztzoys5v7x/app.bsky.feed.post/3myszv3npgs25", "author_did": "did:plc:2iffb6bkoemfluztzoys5v7x", "handle": "chiefakajames.bsky.social", "created_at": "2026-10-27T00:59:40.656Z", "indexed_at": "2026-10-27T00:58:45.378Z", "text": "Timberwolves bench doing some important work here."}, {"uri": "at://did:plc:dfzuqinwhnuvs2jrh54fmmkb/app.bsky.feed.post/3myszqoj37k2d", "author_did": "did:plc:dfzuqinwhnuvs2jrh54fmmkb", "handle": "hattie.meangirls.online", "created_at": "2026-10-27T00:57:12.654Z", "indexed_at": "2026-10-27T00:57:12.874Z", "text": "i am hearing reports that the minnesota timberwolves"}, {"uri": "at://did:plc:leioq57bqzienrlwguxllxqd/app.bsky.feed.post/3myszlmy3yc23", "author_did": "did:plc:leioq57bqzienrlwguxllxqd", "handle": "theothertim.bsky.social", "created_at": "2026-10-27T00:54:23.277Z", "indexed_at": "2026-10-27T00:54:24.571Z", "text": "Wait, something is wrong. There must be a technical error. The other team has more points than the Timberwolves!"}, {"uri": "at://did:plc:aghp3obuelre3wubeblxrxsi/app.bsky.feed.post/3myszjbs5qs2k", "author_did": "did:plc:aghp3obuelre3wubeblxrxsi", "handle": "patiomensch.bsky.social", "created_at": "2026-10-27T00:53:04.440Z", "indexed_at": "2026-10-27T00:53:06.308Z", "text": "I got a compliment on my jacket out in the world. But it was for my Timberwolves jacket, not my Saint Paul jacket!"}, {"uri": "at://did:plc:qkc35xfrpk7t3xwn3bvpyivz/app.bsky.feed.post/3myszhsk27f26", "author_did": "did:plc:qkc35xfrpk7t3xwn3bvpyivz", "handle": "douglasfarmer.bsky.social", "created_at": "2026-10-27T00:52:14.567893Z", "indexed_at": "2026-10-27T00:52:14.975Z", "text": "The Timberwolves will not be tested until New Year's Eve Day, and given that is against the Nuggets, it won't really be much of a test.\nThey're all bad defenders."}, {"uri": "at://did:plc:7z5fjbcg34e4zj53fyiv6rjc/app.bsky.feed.post/3mysz6cnmg22t", "author_did": "did:plc:7z5fjbcg34e4zj53fyiv6rjc", "handle": "bigmeatyclaws.bsky.social", "created_at": "2026-10-27T00:46:56.241Z", "indexed_at": "2026-10-27T00:46:54.771Z", "text": "First real adversity of the season. Let's see how the Timberwolves respond."}, {"uri": "at://did:plc:xv6fclkkhgd3uj6cjlrndujl/app.bsky.feed.post/3mysybxbdbs22", "author_did": "did:plc:xv6fclkkhgd3uj6cjlrndujl", "handle": "pandapete.bsky.social", "created_at": "2026-10-27T00:31:04.780Z", "indexed_at": "2026-10-27T00:31:06.985Z", "text": "Hell yeah. Nothing better than a Hamms after a Timberwolves win!"}, {"uri": "at://did:plc:mrvbh3rnv4jmde3ijv4hj4mh/app.bsky.feed.post/3mysxh7lxop2i", "author_did": "did:plc:mrvbh3rnv4jmde3ijv4hj4mh", "handle": "us-med.bsky.social", "created_at": "2026-10-27T00:16:04+00:00", "indexed_at": "2026-10-27T00:16:08.372Z", "text": ""}, {"uri": "at://did:plc:ywsla6rhibn7h3w6oi6sgkrc/app.bsky.feed.post/3mysxft543s2r", "author_did": "did:plc:ywsla6rhibn7h3w6oi6sgkrc", "handle": "nbarealtimestats.bsky.social", "created_at": "2026-10-27T00:15:20.507239+00:00", "indexed_at": "2026-10-27T00:15:21.080Z", "text": "Halftime \u2014 Minnesota Timberwolves lead by 10\n\nMIN 60\nCLE 50\n\nAnthony Edwards: 20 pts, 2 reb, 2 ast\nDonovan Mitchell: 9 pts, 5 reb, 3 ast\n\n#NBA #Cavs #Timberwolves"}, {"uri": "at://did:plc:mveh6gfufi5b5gc6xa6wmeqr/app.bsky.feed.post/3mysxczqckv2z", "author_did": "did:plc:mveh6gfufi5b5gc6xa6wmeqr", "handle": "usftb.bsky.social", "created_at": "2026-10-27T00:13:47.000Z", "indexed_at": "2026-10-27T00:13:47.380Z", "text": "\u2714\ufe0f#Trending: Rudy Gobert gets candid about Anthony Edwards-led T-Wolves\u2019 trash-talking antics\r\n\r\nhttps://usftb.blog/rudy-gobert-gets-candid-about-anthony-edwards-led-t-wolves-trash-talking-antics/\r\n\r\n#UKNewsBreaking"}, {"uri": "at://did:plc:mrvbh3rnv4jmde3ijv4hj4mh/app.bsky.feed.post/3myswrqsyee2j", "author_did": "did:plc:mrvbh3rnv4jmde3ijv4hj4mh", "handle": "us-med.bsky.social", "created_at": "2026-10-27T00:04:03+00:00", "indexed_at": "2026-10-27T00:04:07.571Z", "text": ""}, {"uri": "at://did:plc:qkc35xfrpk7t3xwn3bvpyivz/app.bsky.feed.post/3myswox3zfc2c", "author_did": "did:plc:qkc35xfrpk7t3xwn3bvpyivz", "handle": "douglasfarmer.bsky.social", "created_at": "2026-10-27T00:02:33.329Z", "indexed_at": "2026-10-27T00:02:34.472Z", "text": "Know what? Yeah.\nLet's do the three-team round-robin tournament again at the All-Star game.\n\nTimberwolves starters vs. Western Conference All Stars vs. Eastern Conference All Stars."}, {"uri": "at://did:plc:6ht6mvee3jf5sxrv2usjzkm5/app.bsky.feed.post/3myswn2xr7s22", "author_did": "did:plc:6ht6mvee3jf5sxrv2usjzkm5", "handle": "claunchin.bsky.social", "created_at": "2026-10-27T00:01:30.275Z", "indexed_at": "2026-10-27T00:01:30.969Z", "text": "I can't see any team in the league that look at these Timberwolves and says: \"Yeah, I want a 7 games series against them\". They look SOLID."}]}]