toyynoh2u", "handle": "forgottenlegacy.bsky.social", "displayName": "The X-Hunter", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:n3wosbba67g2lrwtoyynoh2u/bafkreiepuxwrxw3k3s6wfaawpptmxovzisks6a3rirnktqouaai7jbmgni", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2025-12-21T22:11:21.725Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T02:45:23.761Z", "embed": {"$type": "app.bsky.embed.record", "record": {"cid": "bafyreie527zszehzgdwk3s5dvztfbyqpb6somkmypf4cxwxiuzh3oilthm", "uri": "at://did:plc:5x4sybe5pf7zuj2xzxuxsty5/app.bsky.feed.post/3myy7kp2mkc2n"}}, "langs": ["en"], "text": "\u201cI don\u2019t want trouble.\u201d\n\nKai raises his hands.\n\n\u201cI don\u2019t follow Serges anymore, I want nothing to do with the X-hunters. I just want to know who created me. What I was really made for, cause as much as the Mavericks told me I\u2019m here to scrap X, there\u2019s a voice inside telling me no, that it\u2019s wrong\u2026\u201d"}, "embed": {"record": {"uri": "at://did:plc:5x4sybe5pf7zuj2xzxuxsty5/app.bsky.feed.post/3myy7kp2mkc2n", "cid": "bafyreie527zszehzgdwk3s5dvztfbyqpb6somkmypf4cxwxiuzh3oilthm", "author": {"did": "did:plc:5x4sybe5pf7zuj2xzxuxsty5", "handle": "wilynumberinfinity.bsky.social", "displayName": "\u01b5\ud835\udc04\ud835\udc11\ud835\udc0e.", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:5x4sybe5pf7zuj2xzxuxsty5/bafkreicf6tcqmadgeikllornojwm7ctk3ugwvlr3hi2e46xl4rwyaysrci", "associated": {"chat": {"allowIncoming": "following", "allowGroupInvites": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [{"src": "did:plc:5x4sybe5pf7zuj2xzxuxsty5", "uri": "at://did:plc:5x4sybe5pf7zuj2xzxuxsty5/app.bsky.actor.profile/self", "cid": "bafyreiamwgxisvhy6nmvwemlkv4547zaal5uczdxxcjg36yxgfyqtkciqa", "val": "!no-unauthenticated", "cts": "2026-04-08T20:07:28.134Z"}], "createdAt": "2026-04-08T20:07:28.556Z"}, "value": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T02:24:33.044Z", "embed": {"$type": "app.bsky.embed.recordWithMedia", "media": {"$type": "app.bsky.embed.images", "images": [{"alt": "", "aspectRatio": {"height": 479, "width": 546}, "image": {"$type": "blob", "ref": {"$link": "bafkreifbkz2cc5e4qqvwakaatkcmdqfahzhj6mhqig4z6x7y6dqzejmwue"}, "mimeType": "image/jpeg", "size": 235988}}, {"alt": "", "aspectRatio": {"height": 986, "width": 1000}, "image": {"$type": "blob", "ref": {"$link": "bafkreifwzgesgn3tsxte5qoofcf4wdw4s3az2mlt2bu7dim3vfrijvgiae"}, "mimeType": "image/jpeg", "size": 250590}}]}, "record": {"$type": "app.bsky.embed.record", "record": {"cid": "bafyreico5i6kdwclqzlvsc6smld7l4atnapzenvuc3cmhdzg3a24yykt5q", "uri": "at://did:plc:n3wosbba67g2lrwtoyynoh2u/app.bsky.feed.post/3myxlblqt622g"}}}, "langs": ["en"], "text": "\u201cNo.\u201d\n\nZero drew his saber, the blade igniting with a sharp hum. His grip tightened around the hilt as he studied Kai, processing what he\u2019d just learned about his origins and his connection to the X-Hunters."}, "labels": [], "likeCount": 0, "replyCount": 0, "repostCount": 0, "quoteCount": 1, "indexedAt": "2026-10-29T02:24:33.272Z", "embeds": [{"media": {"images": [{"thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:5x4sybe5pf7zuj2xzxuxsty5/bafkreifbkz2cc5e4qqvwakaatkcmdqfahzhj6mhqig4z6x7y6dqzejmwue", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:5x4sybe5pf7zuj2xzxuxsty5/bafkreifbkz2cc5e4qqvwakaatkcmdqfahzhj6mhqig4z6x7y6dqzejmwue", "alt": "", "aspectRatio": {"height": 479, "width": 546}}, {"thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:5x4sybe5pf7zuj2xzxuxsty5/bafkreifwzgesgn3tsxte5qoofcf4wdw4s3az2mlt2bu7dim3vfrijvgiae", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:5x4sybe5pf7zuj2xzxuxsty5/bafkreifwzgesgn3tsxte5qoofcf4wdw4s3az2mlt2bu7dim3vfrijvgiae", "alt": "", "aspectRatio": {"height": 986, "width": 1000}}], "$type": "app.bsky.embed.images#view"}, "record": {"record": {"uri": "at://did:plc:n3wosbba67g2lrwtoyynoh2u/app.bsky.feed.post/3myxlblqt622g", "cid": "bafyreico5i6kdwclqzlvsc6smld7l4atnapzenvuc3cmhdzg3a24yykt5q", "author": {"did": "did:plc:n3wosbba67g2lrwtoyynoh2u", "handle": "forgottenlegacy.bsky.social", "displayName": "The X-Hunter", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:n3wosbba67g2lrwtoyynoh2u/bafkreiepuxwrxw3k3s6wfaawpptmxovzisks6a3rirnktqouaai7jbmgni", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2025-12-21T22:11:21.725Z"}, "value": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T20:21:32.753Z", "embed": {"$type": "app.bsky.embed.record", "record": {"cid": "bafyreicja2cox4xhun2nuv7t35thzbjq32hettdsywsutnrbnejactyqty", "uri": "at://did:plc:5x4sybe5pf7zuj2xzxuxsty5/app.bsky.feed.post/3myxk4jmyas26"}}, "langs": ["en"], "text": "\u201cI\u2019ll be clear with you.\nThe X-hunters called me Kai. You wouldn\u2019t have met me. They made sure I stayed away from you.\nI don\u2019t know the man who made me, but Serges told me I was built to destroy X, so I listened to him till the day he showed himself to X and got scrapped.\n\nGot any other questions?\u201d"}, "labels": [], "likeCount": 0, "replyCount": 0, "repostCount": 0, "quoteCount": 1, "indexedAt": "2026-10-28T20:21:33.178Z", "$type": "app.bsky.embed.record#viewRecord"}}, "$type": "app.bsky.embed.recordWithMedia#view"}], "$type": "app.bsky.embed.record#viewRecord"}, "$type": "app.bsky.embed.record#view"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 0, "quoteCount": 1, "indexedAt": "2026-10-29T02:45:24.080Z", "labels": []}, {"uri": "at://did:plc:b2264c5zqoa6dbkqrisapi5g/app.bsky.feed.post/3myyanjqkzk2v", "cid": "bafyreihsrbgrdxa5eknusuightfqebze3vvyc5rttz6wcmfsg5nk6flzuu", "author": {"did": "did:plc:b2264c5zqoa6dbkqrisapi5g", "handle": "clarkmatthews.bsky.social", "displayName": "Clark Matthews", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:b2264c5zqoa6dbkqr