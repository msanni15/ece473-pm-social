{"version": 1, "slug": "nba-bkn-nyk-2026-11-02", "side": "home", "team": "nyk", "query": "Knicks", "since": "2026-11-03T03:30:00+00:00", "until": "2026-11-03T04:00:00+00:00", "status": "ok", "retrieved_at": "2026-11-12T01:44:40.921418+00:00", "posts": [{"uri": "at://did:plc:4ds5ilmkzmog7jw6uho4eiwg/app.bsky.feed.post/3mzewxd6qcs2o", "cid": "bafyreiffmogmlqstxlbwhinuutwvre4cniumdqeq7uwjxpcnlaco52utei", "author": {"did": "did:plc:4ds5ilmkzmog7jw6uho4eiwg", "handle": "jordanjamboree.pittbert.gay", "displayName": "jordan", "pronouns": "she/her", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:4ds5ilmkzmog7jw6uho4eiwg/bafkreidhfforvdhlifsh4mypxzxii77x6uy7zxo36scvinpbwpxyi2r5ve", "associated": {"chat": {"allowIncoming": "all", "allowGroupInvites": "none"}, "activitySubscription": {"allowSubscriptions": "mutuals"}}, "labels": [{"src": "did:plc:4ds5ilmkzmog7jw6uho4eiwg", "uri": "at://did:plc:4ds5ilmkzmog7jw6uho4eiwg/app.bsky.actor.profile/self", "cid": "bafyreict7q2yks7vr3vhwuo7crt7j7tzesllam4rwjc7ujk3krnvuen3ea", "val": "!no-unauthenticated", "cts": "1970-01-01T00:00:00.000Z"}], "createdAt": "2023-05-31T17:35:46.042Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-03T03:55:09.728Z", "langs": ["en"], "text": "Being in Vegas during Election Day is going to feel insane I think. Not quite \"in the heart of manhattan when the Knicks won\" crazy, but it's gonna feel weird"}, "bookmarkCount": 0, "replyCount": 3, "repostCount": 0, "likeCount": 51, "quoteCount": 0, "indexedAt": "2026-11-03T03:55:10.580Z", "labels": []}, {"uri": "at://did:plc:na5ld4i76uqmfdlqmubokxih/app.bsky.feed.post/3mzewwqsmy22x", "cid": "bafyreibhseq5tgy5oggd4o3gcrdlhiheh76nfyjttlohje4zzxpgmdkfcu", "author": {"did": "did:plc:na5ld4i76uqmfdlqmubokxih", "handle": "unofficialchamps.bsky.social", "displayName": "Unofficial Champions", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:na5ld4i76uqmfdlqmubokxih/bafkreic7vfrm6gtirreejarfcsgz5w5utquu5su3hc6rfpi7gjtjdjvjzu", "associated