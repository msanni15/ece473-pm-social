/bafkreifa3o4kggb4kkkapmo6xwsfne7fp2yn3tpmkbrvxclmejjrfawqke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-06-23T16:05:02.881Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T03:47:41.879Z", "langs": ["en"], "text": "Thanks to an incredible second-quarter run, the Lakers lead the Clippers 56-38 at the half. Austin Reaves, Matisse Thybulle, and Collin Sexton are all in double figures in points."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 5, "quoteCount": 0, "indexedAt": "2026-10-29T03:47:42.176Z", "labels": []}, {"uri": "at://did:plc:paf4vetn26bu7uggsie3vyrc/app.bsky.feed.post/3myye5m4r4s2p", "cid": "bafyreiejaqaurirczjlbmjymoa6ye3jbawe6wi4iuncizfugwcnaxabrl4", "author": {"did": "did:plc:paf4vetn26bu7uggsie3vyrc", "handle": "lawmurraythenu.bsky.social", "displayName": "Law Murray \ud83d\udcd8", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:paf4vetn26bu7uggsie3vyrc/bafkreihylt4ajsybck7u6howz6ols7nfjinjfis65c2mhouyyyga7bjfbi", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-21T20:18:27.648Z", "verification": {"verifications": [{"issuer": "did:plc:b2kutgxqlltwc6lhs724cfwr", "issuerDisplayName": "The Athletic", "issuerHandle": "theathletic.com", "uri": "at://did:plc:b2kutgxqlltwc6lhs724cfwr/app.bsky.graph.verification/3lnethq2k2k23", "isValid": true, "createdAt": "2025-04-22T04:24:13.340Z"}], "verifiedStatus": "valid", "trustedVerifierStatus": "none"}}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T03:46:42.471Z", "langs": ["en"], "text": "Laker lead 56-38 at halftime\n\nJarred Vanderbilt! 10 minutes, no points, +17 ... looks like he's the new backup center.\n\ngood lord the Clippers offense is a black hole. 6 assists. 10 field goals. 15 turnovers. \n\nLakers outscored Clippers 21-5 off turnovers\n\nReaves: 16 points, 2 rebounds"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 1, "likeCount": 4, "quoteCount": 0, "indexedAt": "2026-10-29T03:46:42.783Z", "labels": []}, {"uri": "at://did:plc:ddcmdof4k5iklckr2almtwkm/app.bsky.feed.post/3myye2pafvc2n", "cid": "bafyreibs4crld6irdkejsrbtq2by3djums3pp5ubr2n4idmke2hqnr6s2e", "author": {"did": "did:plc:ddcmdof4k5iklckr2almtwkm", "handle": "mattmurph24.bsky.social", "displayName": "Matt", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ddcmdof4k5iklckr2almtwkm/bafkreih4ax7r6jvdutmtoilhz2jjxxyewh55gw54xs2lauybqlimrg2bh4", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-15T14:08:23.237Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T03:45:05.073Z", "langs": ["en"], "text": "Lakers lead 56-38 at halftime without Luka."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T03:45:04.477Z", "labels": []}, {"uri": "at://did:plc:dm3ptaozgjfzracwuenwsiiw/app.bsky.feed.post/3myye2iwrqk2z", "cid": "bafyreidpqz4jwfx5cqbj6bc6uf4z774afoa4yc22klnpszor77xcwxwg4q", "author": {"did": "did:plc:dm3ptaozgjfzracwuenwsiiw", "handle": "thebenroyer.bsky.social", "displayName": "Benjamin Royer", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:dm3ptaozgjfzracwuenwsiiw/bafkreidb22vocxuhkfphegszckyhayarjj6cvkkksythvmcxas2lzzohjy", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-07-18T17:56:54.287Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T03:44:58.466Z", "langs": ["en"], "text": "End of 2Q: Lakers 56, Clippers 38\n\nThe Lakers are getting a good look at how to create offense without Luka Don\u010di\u0107 on the floor.\n\nAustin Reaves leads all scorers with 16 pts. Matisse Thybulle has 12.\n\nJarred Vanderbilt has a game-high five rebounds in his season debut."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0