id:plc:b2kutgxqlltwc6lhs724cfwr", "issuerDisplayName": "The Athletic", "issuerHandle": "theathletic.com", "uri": "at://did:plc:b2kutgxqlltwc6lhs724cfwr/app.bsky.graph.verification/3lnethq2k2k23", "isValid": true, "createdAt": "2025-04-22T04:24:13.340Z"}], "verifiedStatus": "valid", "trustedVerifierStatus": "none"}}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-10T01:13:35.552Z", "langs": ["en"], "text": "Lakers lead 68-57 at halftime in Atlanta\n\nWalker Kessler: 15 points, 6/9 FGs, 5 rebounds, 2 assists, 3/3 FTs\n\nFGs: Lakers 24/45, 53.3%; Hawks 19/42, 45.2%\n\nOnly turnover Lakers had in 2nd quarter was when Daniels stole Don\u010di\u010b. Non-Luka Lakers had one first half turnover."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 4, "quoteCount": 0, "indexedAt": "2026-11-10T01:13:35.978Z", "labels": []}, {"uri": "at://did:plc:d7jo2dgltk635ycukifq3qjx/app.bsky.feed.post/3mzwb4rpolc2s", "cid": "bafyreic2uunfk4swvnx7ttu3oadf2a3wocbz5wipmgwfexyyaredk4bgfm", "author": {"did": "did:plc:d7jo2dgltk635ycukifq3qjx", "handle": "ecreates88.bsky.social", "displayName": "Edwin Garcia", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:d7jo2dgltk635ycukifq3qjx/bafkreifa3o4kggb4kkkapmo6xwsfne7fp2yn3tpmkbrvxclmejjrfawqke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-06-23T16:05:02.881Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-10T01:12:25.706Z", "langs": ["en"], "text": "The Lakers lead the Hawks 68-57 at the half. \nLuka Don\u010di\u0107: 14 pts, 4 rebs, 8 asts\nWalker Kessler: 15 pts, 5 rebs, 2 asts\nCollin Sexton: 12 pts, 2 rebs, 4 asts"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 3, "quoteCount": 0, "indexedAt": "2026-11-10T01:12:25.973Z", "labels": []}, {"uri": "at://did:plc:mx62ni2prhriaagd7jfa65zk/app.bsky.feed.post/3mzwazcfids26", "cid": "bafyreiasvsghdmctgjjeoidoowc23qpfzzesqhqr47bksamy6ljfsw2nfi", "author": {"did": "did:plc:mx62ni2prhriaagd7jfa65zk", "handle": "stevejones20.bsky.social", "displayName": "Steve Jones", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:mx62ni2prhriaagd7jfa65zk/bafkreibsasqbomwgwfh2pcbppafnejcmsib2rcnagdsyaeenusuzh5zfqa", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-23T22:04:08.469Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-10T01:10:28.980Z", "embed": {"$type": "app.bsky.embed.video", "aspectRatio": {"height": 716, "width": 1280}, "presentation": "default", "video": {"$type": "blob", "ref": {"$link": "bafkreifxaz5wrn32fywbl4uthhefgb5ju2tiinrzexsmp7kdleiq6hpsge"}, "mimeType": "video/mp4", "size": 3636030}}, "langs": ["en"], "text": "Lakers have continued to work to have Luka Doncic in more off ball movement. One wrinkle is using a wing as a screener, test if a defense wants to switch that matchup. Daniels engages, LaRavia slips. Defense helps on the cut and Walker Kessler dives from the corner."}, "embed": {"cid": "bafkreifxaz5wrn32fywbl4uthhefgb5ju2tiinrzexsmp7kdleiq6hpsge", "playlist": "https://video.bsky.app/watch/did%3Aplc%3Amx62ni2prhriaagd7jfa65zk/bafkreifxaz5wrn32fywbl4uthhefgb5ju2tiinrzexsmp7kdleiq6hpsge/playlist.m3u8", "thumbnail": "https://video.bsky.app/watch/did%3Aplc%3Amx62ni2prhriaagd7jfa65zk/bafkreifxaz5wrn32fywbl4uthhefgb5ju2tiinrzexsmp7kdleiq6hpsge/thumbnail.jpg", "aspectRatio": {"height": 716, "width": 1280}, "presentation": "default", "$type": "app.bsky.embed.video#view"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 8, "quoteCount": 0, "indexedAt": "2026-11-10T01:10:30.171Z", "labels": []}, {"uri": "at://did:plc:yvy5ax23zpmoearxn6xsgqzf/app.bsky.feed.post/3mzwayyh7rk2j", "cid": "bafyreibel67uirmezp6m7itzujljbwmtipllvbt3l2saectbvcfoasyfgq", "author": {"did": "did:plc:yvy5ax23zpmoearxn6xsgqzf", "handle": "btrowland.bsky.social", "displayName": "Brad Rowland", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yvy5ax23zpmoearxn6xsgqzf/bafkreiewn3wnzotxikw45yiyzwfvo5jnimmrouiltejje4xehzcup6dc5i", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-06-21T21:50:45.445Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-10T01:10:18.551Z", "langs": ["en"], "text": "Hawks down 68-57 to the Lakers at halftime after trailing by as many as 20.\n\nLAL had a 23-3 run in the middle of the half after Atlanta had a solid start to the game.\n\nHawks bench units got walloped and ATL committed 10 turnovers."}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 6, "quoteCount": 0, "indexedAt": "2026-11-10T01:10:19.076Z", "labels": []}, {"uri": "at://did:plc:dm3ptaozgjfzracwuenwsiiw/app.bsky.feed.post/3mzwayxv2ps22", "cid": "bafyreie5xuddjz7cw6nwt33urxtpv225kuyg3mnilfx3sviupih7cnywti", "author": {"did": "did:plc:dm3ptaozgjfzracwuenwsiiw", "handle": "thebenroyer.bsky.social", "displayName": "Benjamin Royer", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:dm3ptaozgjfzracwuenwsiiw/bafkreidb22vocxuhkfphegszckyhayarjj6cvkkksythvmcxas2lzzohjy", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-07-18T17:56:54.287Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-10T01:10:17.956Z", "langs": ["en"], "text": "End of 2Q: Lakers 68, Hawks 57\n\nThe Lakers led by as many as 20 pts, using some stellar play from Collin Sexton (12 pts, 4 ast) off the bench. Walker Kessler leads the Lakers with 15 pts, while Luka Doncic has 14 pts, 8 asts and 4 rbs."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-11-10T01:10:18.181Z", "labels": []}, {"uri": "at://did:plc:vj2cbrm7b3p5vosgmrcxhe2g/app.bsky.feed.post/3mzwayj2m422b", "cid": "bafyreihbiwr452czxoim63jyys7td6tajbwfd6xseaviwkmq2x5f6c3djy", "author": {"did": "did:plc:vj2cbrm