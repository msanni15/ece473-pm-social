{"version": 1, "slug": "nba-orl-tor-2026-10-28", "side": "home", "team": "tor", "query": "Raptors", "since": "2026-10-29T00:30:00+00:00", "until": "2026-10-29T01:30:00+00:00", "status": "ok", "retrieved_at": "2026-11-12T01:30:52.750919+00:00", "posts": [{"uri": "at://did:plc:4wagnviqszco5yy37lzgggl3/app.bsky.feed.post/3myy47yenus2z", "cid": "bafyreif6ztcghbl7ecmuspfcirmr3wgaspd374ijupfewt6nn3pby4xrt4", "author": {"did": "did:plc:4wagnviqszco5yy37lzgggl3", "handle": "jm539581.bsky.social", "displayName": "JM =^D", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:4wagnviqszco5yy37lzgggl3/bafkreifpsz2tdwbj32zybcewfzoinja62rdmt6r2skac7dqvk7uxyaiyvu", "associated": {"activitySubscription": {"allowSubscriptions": "none"}}, "labels": [], "createdAt": "2024-11-06T23:47:25.885Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T01:24:52.484Z", "embed": {"$type": "app.bsky.embed.recordWithMedia", "media": {"$type": "app.bsky.embed.images", "images": [{"alt": "", "aspectRatio": {"height": 889, "width": 1552}, "image": {"$type": "blob", "ref": {"$link": "bafkreidsh3kgp2evwg4gslzlbmc4qgaff6w77w73hkhzznzxcnlkr55p5u"}, "mimeType": "image/jpeg", "size": 931120}}]}, "record": {"$type": "app.bsky.embed.record", "record": {"cid": "bafyreibw2ss2xelt4vmvursjhuq7yrewinzhzgc55ofr3tfezlxsomdkzi", "uri": "at://did:plc:4wagnviqszco5yy37lzgggl3/app.bsky.feed.post/3myghdtllbk2b"}}}, "langs": ["en"], "text": "Raptors scored 69 points in the first half. Nice"}, "embed": {"media": {"images": [{"thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:4wagnviqszco5yy37lzgggl3/bafkreidsh3kgp2evwg4gslzlbmc4qgaff6w77w73hkhzznzxcnlkr55p5u", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:4wagnviqszco5yy37lzgggl3/bafkreidsh3kgp2evwg4gslzlbmc4qgaff6w77w73hkhzznzxcnlkr55p5u", "alt": "", "aspectRatio": {"height": 889, "width": 1552}}], "$type": "app.bsky.embed.images#view"}, "record": {"record": {"uri": "at://did:plc:4wagnviqszco5yy37lzgggl3/app.bsky.feed