: "bafyreids373nd52czm6l6oih4iwrzrwu3fitxdsug35utwsip5pc2v23rm", "author": {"did": "did:plc:fhyu4zjougtr3emjwdulollt", "handle": "smithraptorsbeat.bsky.social", "displayName": "Doug Smith", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fhyu4zjougtr3emjwdulollt/bafkreiajribnpdrs22kkygn2qxwwowyitv7otscl6mebx6kty7uijwrk3i", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-06T22:16:16.879Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T00:06:56.715Z", "langs": ["en"], "text": "Since Orlando hasn't seem to have traded for Rudy Gobert, Raptors attacking the rim and have shot 10 FTs in 9 1/2 minutes"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 2, "quoteCount": 0, "indexedAt": "2026-10-29T00:06:57.074Z", "labels": []}, {"uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxxrghu522a", "cid": "bafyreihtglefxrahftaoumqhydralj7pljxma26ti4vegtdq2mrpvpln2y", "author": {"did": "did:plc:fkpnckg4eqizwxmgrxrgwyxo", "handle": "philiprr.bsky.social", "displayName": "Philip Rossman-Reich", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fkpnckg4eqizwxmgrxrgwyxo/bafkreia5yytn63svxtqdkdptgsmyydn6pq4k5kko77upzeyupxjbgkwkke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-18T16:37:49.540Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T00:05:08.989Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 31, "byteStart": 25}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Raptors"}], "index": {"byteEnd": 184, "byteStart": 176}}], "langs": ["en"], "reply": {"parent": {"cid": "bafyreifwgexuxqcvz4v2ryqow335m6f45rwahgt25jmezvxvvl5pkkzsgq", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxxeu7bbs2a"}, "root": {"cid": "bafyreigjyqwct2o2cay4qdfwgcttbip6thbc7wooqzns3rq4typazgbqma", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxvqv44lk2a"}}, "text": "About the only thing the #Magic have not done effectively is make threes -- at 2 for 9. That has kept them from pulling away. Now the turnovers are starting to pile up and the #Raptors are getting to the line.\n\nORL 21:19 TOR 2:52 1st"}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T00:05:10.677Z", "labels": []}, {"uri": "at://did:plc:i7pcqindxdleiildptnaikoa/app.bsky.feed.post/3myxxqrepnc2g", "cid": "bafyreif5dm7jrsbz27i77q6dvmkozog7pc76xxjwf2fn7qiev2ch46cbqa", "author": {"did": "did:plc:i7pcqindxdleiildptnaikoa", "handle": "woodleysean.bsky.social", "displayName": "Sean Woodley", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:i7pcqindxdleiildptnaikoa/bafkreif7zlhbnnm3xbaxmsq7ucnjqoicu3sxmsxxm7ahq5st57meipceyy", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-06T18:59:02.580Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T00:04:46.866Z", "langs": ["en"], "text": "raptors have franz in hell dude"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 3, "quoteCount": 0, "indexedAt": "2026-10-29T00:04:47.481Z", "labels": []}, {"uri": "at://did:plc:32wf2tdbchgci235ycgkbxi3/app.bsky.feed.post/3myxxqmkpvs2w", "cid": "bafyreihfk27eextcuh6heam5oyui6stgmgvd5zmuptqlqk2hvlbtitafuq", "author": {"did": "did:plc:32wf2tdbchgci235ycgkbxi3", "handle": "aguyuno.bsky.social", "displayName": "Azure", "pronouns": "he/they", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:32wf2tdbchgci235ycgkbxi3/bafkreidqq6rjf3cdvxjy2i24ubh6llidwlk2fokvbcvxzyw6bc4po6z34m", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-05-10T18:12:02.593Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T00:04:41.820Z", "langs": ["en"], "text": "This Raptors game once again asking the question: Should the Raptors maybe have made more than one (1) fucking trade all off season.\n\nThe answer, of course, is yes."}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T00:04:42.071Z", "labels": []}, {"uri": "at://did:plc:3ph7mooqt5acnzv53x5copif/app.bsky.feed.post/3myxxofovls2w", "cid": "bafyreie2rty4igfpuvi5y3ruqadqseh45ed3whrc4ca5kbjiy4gwfbahju", "author": {"did": "did:plc:3ph7mooqt5acnzv53x5copif", "handle": "palaeohammer.bsky.social", "displayName": "The Palaeontologist's Hammer", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:3ph7mooqt5acnzv53x5copif/bafkreiea26pdntsqrmcda6rmydsj5whp3c67gdj2zqfr5buf5swrfxqvam", "associated": {"chat": {"allowIncoming": "all"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-13T05:59:19.282Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T00:03:27.507Z", "langs": ["en"], "text": "Raptors call timeout after poor run at 10-7. Possessions since then:\n\nTurnover (offensive foul), RJ 1/2 FT, Scottie miss 20 ft jumper, CMB steal to failed3-on-1, JaKobe pick6, CMB turnover, CMB+RJ misses, Shead+TJD misses, TJD turnover\n\nThat seven of eight awful possessions. Ugly, unimpressive start"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T00:03:28.375Z", "labels": []}, {"uri": "at://did:plc:u6t3uzucvcjqvhnjo3kggzem/app.bsky.feed.post/3myxxlfg2ok2a", "cid": "bafyreifihgp4kjyliiixm4jhr4ytuhtibsspcsklgmohuitz4bt3qxhupa", "author": {"did": "did:plc:u6t3uzucvcjqvhnjo3kggzem", "handle": "var.eurosky.social", "displayName": "Var", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:u6t3uzucvcjqvhnjo3kggzem/bafkreic7u7iegal63sl3m6ct55tli6kszsofzw45tas6rntvmpwff4fajy", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2026-09-25T18:37:48.452Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-29T00:01:46.532Z", "langs": ["en"], "text": "Raptors have essentially two players in RJ and Ja'Kobe that are actually playing decent. Everyone else looks off."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-29T00:01:47.680Z", "labels": []}, {"uri": "at://did:plc:i7pcqindxdleiildptnaikoa/app.bsky.feed.post/3myxxgqj73s2g", "cid": "bafyreibuerzofqkhf5hiskl4ygufv7zmx3u6nclnxerngu5tgysqzxikja", "author": {"did": "did:plc:i7pcqindxdleiildptnaikoa", "handle": "woodleysean.bsky.social", "displayName": "Sean Woodley", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:i7pcqindxdleiildptnaikoa/bafkreif7zlhbnnm3xbaxmsq7ucnjqoicu3sxmsxxm7ahq5st57meipceyy", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-06T18:59:02.580Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:59:10.420Z", "langs": ["en"], "text": "i've seen better 8 minute stretches of toronto raptors basketball in my life"}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 9, "quoteCount": 0, "indexedAt": "2026-10-28T23:59:10.972Z", "labels": []}, {"uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxxeu7bbs2a", "cid": "bafyreifwgexuxqcvz4v2ryqow335m6f45rwahgt25jmezvxvvl5pkkzsgq", "author": {"did": "did:plc:fkpnckg4eqizwxmgrxrgwyxo", "handle": "philiprr.bsky.social", "displayName": "Philip Rossman-Reich", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fkpnckg4eqizwxmgrxrgwyxo/bafkreia5yytn63svxtqdkdptgsmyydn6pq4k5kko77upzeyupxjbgkwkke", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-08-18T16:37:49.540Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:58:07.180Z", "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Raptors"}], "index": {"byteEnd": 125, "byteStart": 117}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Magic"}], "index": {"byteEnd": 133, "byteStart": 127}}], "langs": ["en"], "reply": {"parent": {"cid": "bafyreigygotvaw53q2ndchifzke3fbyqwnnjibcc5cu64iorwyi3znt3vi", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxwlxtlqk2a"}, "root": {"cid": "bafyreigjyqwct2o2cay4qdfwgcttbip6thbc7wooqzns3rq4typazgbqma", "uri": "at://did:plc:fkpnckg4eqizwxmgrxrgwyxo/app.bsky.feed.post/3myxvqv44lk2a"}}, "text": "Oooooooh... Our first Vooch/Dell lineup of the year. Interesting choice to go against the smaller frontcourt for the #Raptors. #Magic are on a nice run right now to build out their lead. Doing a great job challenging at the rim and forcing turnovers.\n\nORL 19:10 TOR 5:24 1st"}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-28T23:58:07.581Z", "labels": []}, {"uri": "at://did:plc:lohipf3co6wyf5fd7psv3e2v/app.bsky.feed.post/3myxxeshrvc2e", "cid": "bafyreihgrexsd444udjg3kqaktxohczauaaljp7zmresjowjyc7x7qxqsu", "author": {"did": "did:plc:lohipf3co6wyf5fd7psv3e2v", "handle": "chuued.blacksky.app", "displayName": "Federally Subsidized Kool-Aid Jammer", "pronouns": "", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:lohipf3co6wyf5fd7psv3e2v/bafkreigvcyeerq2hzi4daym2ijnwnfsmv54a4kq3ml5uuholtp7u4ldpqm", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-07-24T03:12:58.048Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:58:05.362Z", "langs": ["en"], "text": "Raptors coming out real flat again."}, "bookmarkCount": 0, "replyCount": 2, "repostCount": 0, "likeCount": 1, "quoteCount": 0, "indexedAt": "2026-10-28T23:58:05.172Z", "labels": []}, {"uri": "at://did:plc:75ywphuamkbx76cq6efue5y5/app.bsky.feed.post/3myxxensmhc2a", "cid": "bafyreiaelgfmlpjcv4wibn4rn6ouevtjhk5t7fjsgp3rjvhrgxxi65pq7q", "author": {"did": "did:plc:75ywphuamkbx76cq6efue5y5", "handle": "jlewenberg.bsky.social", "displayName": "Josh Lewenberg", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:75ywphuamkbx76cq6efue5y5/bafkreih7kszzs5gl72sg5igovpbjfglyrxgpzrq4dfzi27zy5dgx5ep3im", "associated": {"chat": {"allowIncoming": "none"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-30T19:46:50.450Z", "verification": {"verifications": [{"issuer": "did:plc:z72i7hdynmk6r22z27h6tvur", "issuerDisplayName": "Bluesky", "issuerHandle": "bsky.app", "uri": "at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3m4y5jsuu272r", "isValid": true, "createdAt": "2025-11-06T18:02:50.132Z"}], "verifiedStatus": "valid", "trustedVerifierStatus": "none"}}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:58:00.473Z", "langs": ["en"], "text": "Kawhi or no Kawhi, the Raptors aren't going to win many games defending like this. Trayce Jackson-Davis gets an early look, in place of Allen Graves (who was one of the few bright spots in Minnesota). Orlando leads 19-10."}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 1, "likeCount": 4, "quoteCount": 0, "indexedAt": "2026-10-28T23:58:01.181Z", "labels": []}, {"uri": "at://did:plc:75ywphuamkbx76cq6efue5y5/app.bsky.feed.post/3myxwykme6c2a", "cid": "bafyreibq5heswjrpvoxwy4sn3aoljraluco55rihdmfjswtlzykn5jniu4", "author": {"did": "did:plc:75ywphuamkbx76cq6efue5y5", "handle": "jlewenberg.bsky.social", "displayName": "Josh Lewenberg", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:75ywphuamkbx76cq6efue5y5/bafkreih7kszzs5gl72sg5igovpbjfglyrxgpzrq4dfzi27zy5dgx5ep3im", "associated": {"chat": {"allowIncoming": "none"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-30T19:46:50.450Z", "verification": {"verifications": [{"issuer": "did:plc:z72i7hdynmk6r22z27h6tvur", "issuerDisplayName": "Bluesky", "issuerHandle": "bsky.app", "uri": "at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3m4y5jsuu272r", "isValid": true, "createdAt": "2025-11-06T18:02:50.132Z"}], "verifiedStatus": "valid", "trustedVerifierStatus": "none"}}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:51:14.470Z", "langs": ["en"], "text": "Nice to see Barnes getting in the paint, attacking the bucket and crashing the glass early. Not-so-nice-to-see: the Raptors throwing/kicking the ball all over the place. They've committed 3 turnovers in 3.5 minutes, leading to 6 of Orlando's 10 points. Early Darko timeout."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 1, "quoteCount": 0, "indexedAt": "2026-10-28T23:51:15.083Z", "labels": []}, {"uri": "at://did:plc:fhyu4zjougtr3emjwdulollt/app.bsky.feed.post/3myxwq2iayk2b", "cid": "bafyreiaaojgr4resdvwdnwcxutrs6osr2a3qgmyw3joydlsdf57rwzdzgm", "author": {"did": "did:plc:fhyu4zjougtr3emjwdulollt", "handle": "smithraptorsbeat.bsky.social", "displayName": "Doug Smith", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:fhyu4zjougtr3emjwdulollt/bafkreiajribnpdrs22kkygn2qxwwowyitv7otscl6mebx6kty7uijwrk3i", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-06T22:16:16.879Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:46:29.122Z", "langs": ["en"], "text": "Scottie Barnes got on the paint on the first possession for the Raptors, dunked a minute or two later and just fed a nice to Poeltl, who missed 2 FTs before Barnes rebounded the second and scored\n\nWe're not in Minneapolis anymore"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 4, "quoteCount": 0, "indexedAt": "2026-10-28T23:46:29.384Z", "labels": []}, {"uri": "at://did:plc:eyvm7str3yhpirijzimdhali/app.bsky.feed.post/3myxwo4krrc22", "cid": "bafyreiffxkjytmp3yhzyvt55xfrsxwuaje2a4dlnwvxa5mm5ngcsrmpag4", "author": {"did": "did:plc