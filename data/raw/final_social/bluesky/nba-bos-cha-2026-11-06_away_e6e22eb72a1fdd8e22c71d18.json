eed.post", "createdAt": "2026-11-07T00:40:32.704Z", "langs": ["en"], "text": "Jayson Tatum puts up 18 points in the first quarter as the Celtics score 40, knocking down nine 3-pointers while shooting 48% overall.\n\nBoston holds Charlotte to 30% shooting, including 14% from three."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 1, "likeCount": 4, "quoteCount": 0, "indexedAt": "2026-11-07T00:40:36.413Z", "labels": []}, {"uri": "at://did:plc:dnxkqc6rsqossh7uhyobkeua/app.bsky.feed.post/3mzonvpm5p22y", "cid": "bafyreiev54k6yhlizxlo454qswg2gummclnk637x6vrjof4fb56w36bs6e", "author": {"did": "did:plc:dnxkqc6rsqossh7uhyobkeua", "handle": "bobbykrivitsky.bsky.social", "displayName": "Bobby Krivitsky", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:dnxkqc6rsqossh7uhyobkeua/bafkreico5zyufbnodb5nzc2crnx7rm453722niv7tsvca3u2mrjotqiasq", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-13T21:39:03.382Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-11-07T00:39:49.346Z", "langs": ["en"], "text": "They only got one basket out of it, a deep 3 from Hauser, but that was excellent defensive execution by the Celtics.\n\nThey blitzed immediately, leading to a quick shot from the Hornets. Boston got a 2-for-1 with about 15 seconds left in the quarter."}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 4, "quoteCount": 0, "indexedAt": "2026-11-07T00:39:49.669Z", "labels": []}, {"uri": "at://did:plc:zvgi4eon2fvlemnmaqnmayuk/app.bsky.feed.post/3mzonuiwj2p2f", "cid": "bafyreiae2rsjgypmbd2x2iyoeza4hts4r2mdy366wu3lclhgpyuwnwhiue", "author": {"did": "did:plc:zvgi4eon2fvlemnmaqnmayuk", "handle": "johnkaralis.com", "displayName": "John Karalis", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:zvgi4eon2fvlemnmaqnmayuk/bafkreie25sf2n2mx2ht6afy4ee5tleltyliuytufixcf4meo23dploz5iu", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "crea