23:37:55.344Z", "embed": {"$type": "app.bsky.embed.video", "aspectRatio": {"height": 720, "width": 1280}, "presentation": "default", "video": {"$type": "blob", "ref": {"$link": "bafkreif3wercy4yp3gt2cwetdujfbtepxpfy6dxioyed5ilgazowzbwxye"}, "mimeType": "video/mp4", "size": 28097182}}, "langs": ["en"], "text": "The Raptors knew Kawhi was going to miss games, but with the 7-game playoff series against Cleveland fresh in their minds, they were confident that they would be good enough and deep enough to win without him. We\u2019re about to find out:"}, "embed": {"cid": "bafkreif3wercy4yp3gt2cwetdujfbtepxpfy6dxioyed5ilgazowzbwxye", "playlist": "https://video.bsky.app/watch/did%3Aplc%3A75ywphuamkbx76cq6efue5y5/bafkreif3wercy4yp3gt2cwetdujfbtepxpfy6dxioyed5ilgazowzbwxye/playlist.m3u8", "thumbnail": "https://video.bsky.app/watch/did%3Aplc%3A75ywphuamkbx76cq6efue5y5/bafkreif3wercy4yp3gt2cwetdujfbtepxpfy6dxioyed5ilgazowzbwxye/thumbnail.jpg", "aspectRatio": {"height": 720, "width": 1280}, "presentation": "default", "$type": "app.bsky.embed.video#view"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 2, "quoteCount": 0, "indexedAt": "2026-10-28T23:37:59.877Z", "labels": []}]}