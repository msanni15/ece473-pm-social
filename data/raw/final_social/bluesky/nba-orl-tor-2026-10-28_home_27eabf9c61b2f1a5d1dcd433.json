11-15T11:53:40.921Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:42:58.687136+00:00", "langs": ["en"], "text": "\ud83c\udfc0 ORL @ TOR \u2014 game time\n\n#NBA #Raptors #Magic"}, "bookmarkCount": 0, "replyCount": 1, "repostCount": 0, "likeCount": 0, "quoteCount": 0, "indexedAt": "2026-10-28T23:42:58.874Z", "labels": []}, {"uri": "at://did:plc:vj632zdj2gqrni63yn7ipql4/app.bsky.feed.post/3myxwdht7pc2f", "cid": "bafyreicm4cymrordlsocakhzao64azgvinqppkvnbxnptibcuko4lawydq", "author": {"did": "did:plc:vj632zdj2gqrni63yn7ipql4", "handle": "jchidleyhill.bsky.social", "displayName": "John \"Chud\" Chidley-Hill", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:vj632zdj2gqrni63yn7ipql4/bafkreigulgf2tz6owmuppmcxj2qnzt65p64jttegtk6y3pdpkhlyysae5q", "associated": {"chat": {"allowIncoming": "none"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-11-15T23:16:30.442Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-10-28T23:39:26.902Z", "langs": ["en"], "text": "It's Hallowe'en night here at Scotiabank Arena as the Toronto Raptors host the Orlando Magic, despite the fact that these two teams will play here again on Friday night, the day before actual Hallowe'en. I assume this is to protect the sanctity of Friday's NBA Cup game"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 1, "likeCount": 2, "quoteCount": 0, "indexedAt": "2026-10-28T23:39:27.271Z", "labels": []}, {"uri": "at://did:plc:h3d5i4ygfpggnjhfwqw34s7m/app.bsky.feed.post/3myxwberudk25", "cid": "bafyreig4qhmp74c5zq3zvrzhpso5dro4p6k6ph7mo25en2ht5yxmf2envy", "author": {"did": "did:plc:h3d5i4ygfpggnjhfwqw34s7m", "handle": "lamchop99.bsky.social", "displayName": "Lisa Murphy", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:h3d5i4ygfpggnjhfwqw34s7m/bafkreihslw3civpoy67v3lzxxbt6gzhrsfqopnd5ewbuo5pephfxqga5ru", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "20